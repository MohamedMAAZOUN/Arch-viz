# Copy to .env (loaded by `pnpm dev` via tsx --env-file) and adjust.
# Validation lives in src/config.ts — the server refuses to boot on bad config.

# --- required -----------------------------------------------------------
DATABASE_URL=postgres://arch_vis:arch_vis@localhost:5432/arch_vis

# --- optional (defaults shown) -------------------------------------------
# NODE_ENV=development
# HOST=0.0.0.0
# PORT=3001

# --- auth modes (ADR 0014: both can coexist; each toggleable) ------------
# AUTH_LOCAL_ENABLED=true
# AUTH_REGISTRATION_ENABLED=true     # self-service /auth/register (local mode)
# AUTH_OIDC_ENABLED=false
# When AUTH_OIDC_ENABLED=true, the four required OIDC_* values must be set:
# OIDC_ISSUER_URL=https://am.example.com/am/oauth2/realms/root/realms/myrealm
# OIDC_CLIENT_ID=arch-vis
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URI=https://app.example.com/auth/oidc/callback
# OIDC_SCOPES="openid profile email"                     # optional (default shown)
# OIDC_POST_LOGOUT_REDIRECT_URI=https://app.example.com  # optional RP-initiated logout

# --- sessions & CSRF (#57) -----------------------------------------------
# SESSION_SECRET must be a strong random value in production (signs short-lived
# cookies such as the OIDC PKCE state). The server refuses to boot in production
# while it is left at the insecure default.
# SESSION_SECRET=dev-insecure-session-secret-please-change
# SESSION_IDLE_TTL_MIN=720           # idle lifetime (12h)
# SESSION_ABSOLUTE_TTL_MIN=10080     # absolute lifetime (7d)
# SESSION_ROTATION_MIN=10            # token rotation cadence
# COOKIE_SECURE=                     # "true"/"false"; defaults on in production
# WEB_ORIGIN=http://localhost:5173   # CSRF allow-list (comma-separated)
# ADMIN_EMAILS=                      # comma-separated; seeds is_admin on creation
