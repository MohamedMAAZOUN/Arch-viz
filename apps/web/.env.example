# Web app environment (Vite). Copy to `.env.local` for local development.

# Base URL of the backend API (ADR 0014). Leave empty for same-origin (the
# production default: one container serves the SPA and the API). In local dev
# the web app runs on :5173 and the server on :3001, so point this at the server:
VITE_API_BASE_URL=http://localhost:3001
